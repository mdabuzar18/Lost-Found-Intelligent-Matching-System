# Environment Configuration for Lost & Found Intelligent Matching System

DEBUG=True
SECRET_KEY=django-insecure-lost-and-found-intelligent-matching-secret-key-2026

# Database Mode (Default: SQLite for zero-friction local development)
USE_POSTGRES=False
DB_NAME=lostfound_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432

# Matching Algorithm Hyperparameters
MATCH_TIME_WINDOW_DAYS=14
MATCH_GEO_MAX_KM=5.0
MATCH_MIN_CONFIDENCE_THRESHOLD=35.0

# Optional Cloud Storage (defaults to local media folder)
# AWS_STORAGE_BUCKET_NAME=my-lostfound-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
